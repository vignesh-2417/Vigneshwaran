{
  "manifest_version": 3,
  "name": "Salesforce Metadata Copilot",
  "version": "0.1.0",
  "description": "Floating assistant for Salesforce metadata requirements on Lightning pages.",
  "minimum_chrome_version": "114",
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.salesforce-setup.com/*"
      ],
      "exclude_matches": [
        "https://login.salesforce.com/*",
        "https://test.salesforce.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "action": {
    "default_title": "Salesforce Metadata Copilot"
  }
}
