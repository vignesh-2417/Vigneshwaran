# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini       # or gpt-4o for better accuracy

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Local: mongodb://localhost:27017/fixforce
# Atlas:  mongodb+srv://user:pass@cluster.mongodb.net/fixforce
MONGODB_URI=mongodb://localhost:27017/fixforce
MONGODB_DB_NAME=fixforce

# ─── Security ─────────────────────────────────────────────────────────────────
# Optional: require this header on all requests (set same value in background.js)
API_SECRET_KEY=change-me-in-production

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000      # 1 minute
RATE_LIMIT_MAX_REQUESTS=30      # per window per IP

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Chrome extensions use chrome-extension:// origin
ALLOWED_ORIGINS=chrome-extension://,http://localhost:3000
