<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Order_Form_Line_Type__c</fullName>
    <description>Bundle, Product, or Bundle Component. Used by Order Form grouping and Docusign Gen filters.</description>
    <externalId>false</externalId>
    <formula>IF(
    NOT(ISBLANK(Bundle_Parent__c)),
    "Bundle Component",
    IF(Is_Bundle__c, "Bundle", "Product")
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Order Form Line Type</label>
    <required>false</required>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
